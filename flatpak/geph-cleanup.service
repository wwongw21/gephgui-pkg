[Unit]
Description=Geph Flatpak self-cleanup (removes the host manager after the Flatpak is uninstalled)

[Service]
Type=oneshot
# Legacy staging asset required by the pinned GUI bootstrap. New installers do
# not install or enable this unit; migration removes an older installed copy.
ExecStart=@BINDIR@/geph-flatpak-watchdog @OWNER@ @BINDIR@
